<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>simple_test</name>
    <description>Minimal smoke test transformation for xxl-job-kettle.</description>
    <trans_version>1</trans_version>
    <trans_type>Normal</trans_type>
    <parameters/>
    <variables/>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <capture_transformance>N</capture_transformance>
    <created_user>agent</created_user>
    <created_date>2026/06/09 00:00:00.000</created_date>
    <modified_user>agent</modified_user>
    <modified_date>2026/06/09 00:00:00.000</modified_date>
  </info>

  <step>
    <name>Generate Rows</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>msg</name>
        <type>String</type>
        <format/>
        <length>200</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
      </field>
    </fields>
    <limit>1</limit>
    <rowtime>0</rowtime>
    <rowspeed>0</rowspeed>
    <field>msg</field>
    <value>Hello from simple_test.ktr</value>
  </step>

  <step>
    <name>Text file output</name>
    <type>TextFileOutput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <compression>None</compression>
    <encoding>UTF-8</encoding>
    <endedLine/>
    <file>
      <name>/opt/pdi/logs/simple_test</name>
      <extention>csv</extention>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields>
      <field>
        <name>msg</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <trim_type>none</trim_type>
        <length>-1</length>
        <precision>-1</precision>
      </field>
    </fields>
  </step>

  <order>
    <hop>
      <from>Generate Rows</from>
      <to>Text file output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
</transformation>
