<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xxl.job.admin.dao.XxlKettleGroupDao">

    <resultMap id="XxlKettleGroup" type="com.xxl.job.admin.core.model.XxlKettleGroup">
        <result column="id" property="id"/>
        <result column="group_name" property="groupName"/>
        <result column="group_desc" property="groupDesc"/>
        <result column="add_time" property="addTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        t.id,
        t.group_name,
        t.group_desc,
        t.add_time,
        t.update_time
    </sql>

    <select id="findAll" resultMap="XxlKettleGroup">
        SELECT <include refid="Base_Column_List"/>
        FROM xxl_kettle_group AS t
        ORDER BY t.id ASC
    </select>

    <select id="load" parameterType="java.lang.Integer" resultMap="XxlKettleGroup">
        SELECT <include refid="Base_Column_List"/>
        FROM xxl_kettle_group AS t
        WHERE t.id = #{id}
    </select>

    <select id="loadByName" parameterType="java.lang.String" resultMap="XxlKettleGroup">
        SELECT <include refid="Base_Column_List"/>
        FROM xxl_kettle_group AS t
        WHERE t.group_name = #{groupName}
    </select>

    <insert id="save" parameterType="com.xxl.job.admin.core.model.XxlKettleGroup"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO xxl_kettle_group (`group_name`, `group_desc`, `add_time`, `update_time`)
        VALUES (#{groupName}, #{groupDesc}, #{addTime}, #{updateTime})
    </insert>

    <update id="update" parameterType="com.xxl.job.admin.core.model.XxlKettleGroup">
        UPDATE xxl_kettle_group
        SET `group_name`  = #{groupName},
            `group_desc`  = #{groupDesc},
            `update_time` = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="remove" parameterType="java.lang.Integer">
        DELETE
        FROM xxl_kettle_group
        WHERE id = #{id}
    </delete>

    <select id="pageList" parameterType="java.util.HashMap" resultMap="XxlKettleGroup">
        SELECT <include refid="Base_Column_List"/>
        FROM xxl_kettle_group AS t
        <trim prefix="WHERE" prefixOverrides="AND | OR">
            <if test="groupName != null and groupName != ''">
                AND t.group_name LIKE CONCAT(CONCAT('%', #{groupName}), '%')
            </if>
        </trim>
        ORDER BY t.id ASC
        LIMIT #{offset}, #{pagesize}
    </select>

    <select id="pageListCount" parameterType="java.util.HashMap" resultType="int">
        SELECT COUNT(1)
        FROM xxl_kettle_group AS t
        <trim prefix="WHERE" prefixOverrides="AND | OR">
            <if test="groupName != null and groupName != ''">
                AND t.group_name LIKE CONCAT(CONCAT('%', #{groupName}), '%')
            </if>
        </trim>
    </select>

</mapper>
