<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xxl.job.admin.dao.XxlKettleFileDao">

    <resultMap id="XxlKettleFile" type="com.xxl.job.admin.core.model.XxlKettleFile">
        <result column="id" property="id"/>
        <result column="group_id" property="groupId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_type" property="fileType"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="version" property="version"/>
        <result column="job_id" property="jobId"/>
        <result column="remark" property="remark"/>
        <result column="add_time" property="addTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="group_name" property="groupName"/>
    </resultMap>

    <sql id="Base_Column_List">
        t.id,
        t.group_id,
        t.file_name,
        t.file_type,
        t.file_path,
        t.file_size,
        t.version,
        t.job_id,
        t.remark,
        t.add_time,
        t.update_time
    </sql>

    <select id="load" parameterType="java.lang.Integer" resultMap="XxlKettleFile">
        SELECT f.*, g.group_name
        FROM xxl_kettle_file AS f
                 LEFT JOIN xxl_kettle_group AS g ON f.group_id = g.id
        WHERE f.id = #{id}
    </select>

    <select id="findByGroupAndName" resultMap="XxlKettleFile">
        SELECT <include refid="Base_Column_List"/>
        FROM xxl_kettle_file AS t
        WHERE t.group_id = #{groupId}
          AND t.file_name = #{fileName}
        LIMIT 1
    </select>

    <insert id="save" parameterType="com.xxl.job.admin.core.model.XxlKettleFile"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO xxl_kettle_file (`group_id`, `file_name`, `file_type`, `file_path`,
                                     `file_size`, `version`, `job_id`, `remark`,
                                     `add_time`, `update_time`)
        VALUES (#{groupId}, #{fileName}, #{fileType}, #{filePath},
                #{fileSize}, #{version}, #{jobId}, #{remark},
                #{addTime}, #{updateTime})
    </insert>

    <update id="update" parameterType="com.xxl.job.admin.core.model.XxlKettleFile">
        UPDATE xxl_kettle_file
        SET `file_name`   = #{fileName},
            `file_type`   = #{fileType},
            `file_path`   = #{filePath},
            `file_size`   = #{fileSize},
            `version`     = #{version},
            `job_id`      = #{jobId},
            `remark`      = #{remark},
            `update_time` = #{updateTime}
        WHERE id = #{id}
    </update>

    <delete id="remove" parameterType="java.lang.Integer">
        DELETE
        FROM xxl_kettle_file
        WHERE id = #{id}
    </delete>

    <delete id="removeByGroupId" parameterType="java.lang.Integer">
        DELETE
        FROM xxl_kettle_file
        WHERE group_id = #{groupId}
    </delete>

    <select id="countByGroupId" parameterType="java.lang.Integer" resultType="int">
        SELECT COUNT(1)
        FROM xxl_kettle_file
        WHERE group_id = #{groupId}
    </select>

    <select id="pageList" parameterType="java.util.HashMap" resultMap="XxlKettleFile">
        SELECT f.*, g.group_name
        FROM xxl_kettle_file AS f
        LEFT JOIN xxl_kettle_group AS g ON f.group_id = g.id
        WHERE f.group_id = #{groupId}
        <if test="keyword != null and keyword != ''">
            AND f.file_name LIKE CONCAT(CONCAT('%', #{keyword}), '%')
        </if>
        <if test="fileType != null and fileType != ''">
            AND f.file_type = #{fileType}
        </if>
        ORDER BY f.update_time DESC
        LIMIT #{offset}, #{pagesize}
    </select>

    <select id="pageListCount" parameterType="java.util.HashMap" resultType="int">
        SELECT COUNT(1)
        FROM xxl_kettle_file AS f
        WHERE f.group_id = #{groupId}
        <if test="keyword != null and keyword != ''">
            AND f.file_name LIKE CONCAT(CONCAT('%', #{keyword}), '%')
        </if>
        <if test="fileType != null and fileType != ''">
            AND f.file_type = #{fileType}
        </if>
    </select>

</mapper>
