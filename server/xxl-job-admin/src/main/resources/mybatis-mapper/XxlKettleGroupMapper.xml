<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xxl.job.admin.dao.XxlKettleGroupDao">
    <resultMap id="XxlKettleGroup" type="com.xxl.job.admin.core.model.XxlKettleGroup">
        <result column="id" property="id"/>
        <result column="group_name" property="groupName"/>
        <result column="group_desc" property="groupDesc"/>
        <result column="add_time" property="addTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="findAll" resultMap="XxlKettleGroup">SELECT * FROM xxl_kettle_group ORDER BY id DESC</select>
    <select id="load" resultMap="XxlKettleGroup">SELECT * FROM xxl_kettle_group WHERE id = #{id}</select>
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO xxl_kettle_group(group_name, group_desc, add_time, update_time) VALUES(#{groupName}, #{groupDesc}, #{addTime}, #{updateTime})
    </insert>
    <update id="update">
        UPDATE xxl_kettle_group SET group_name=#{groupName}, group_desc=#{groupDesc}, update_time=#{updateTime} WHERE id = #{id}
    </update>
    <delete id="remove">DELETE FROM xxl_kettle_group WHERE id = #{id}</delete>
</mapper>
